#!/usr/bin/env bash

set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"

if [[ "${SCRIPT_DIR}" == "/usr/local/bin" || "${SCRIPT_DIR}" == "/usr/bin" ]]; then
    SENTINEL_APP_ROOT="/usr/local/lib/sapphire-sentinel"
    # shellcheck source=/usr/local/lib/sapphire-sentinel/lib/paths.sh
    source "${SENTINEL_APP_ROOT}/lib/paths.sh"
else
    PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
    # shellcheck source=../lib/paths.sh
    source "${PROJECT_ROOT}/lib/paths.sh"
fi

sentinel_ensure_directories

COMMAND="${1:-}"
SUBCOMMAND="${2:-}"

show_help() {
    echo "Sapphire Sentinel"
    echo "Usage:"
    echo "  sentinel init"
    echo "  sentinel config"
    echo "  sentinel start [mode] [context_type] [context_value]"
    echo "  sentinel attach [context_type] [context_value]"
    echo "  sentinel signal [command|error|note] [details]"
    echo "  sentinel stop"
    echo "  sentinel status"
    echo "  sentinel session [--last|--today]"
    echo "  sentinel sessions [--last|--today]"
    echo "  sentinel story [--last|session_id]"
    echo "  sentinel report day"
    echo "  sentinel report week"
    echo "  sentinel report month"
    echo "  sentinel update"
    echo "  sentinel help"
    echo
    echo "Mode: ${SENTINEL_MODE}"
}

run_engine() {
    local engine_name="$1"
    local engine_file="${SENTINEL_ENGINE_DIR}/${engine_name}"
    shift || true

    if [[ ! -x "$engine_file" ]]; then
        echo "Engine missing or not executable: $engine_file"
        exit 1
    fi

    "$engine_file" "$@"
}

case "$COMMAND" in
    init)
        run_engine "init.sh"
        ;;
    config)
        run_engine "config.sh"
        ;;
    start)
        shift || true
        run_engine "start.sh" "$@"
        ;;
    attach)
        shift || true
        run_engine "attach.sh" "$@"
        ;;
    signal)
        shift || true
        run_engine "signal.sh" "$@"
        ;;
    stop)
        run_engine "stop.sh"
        ;;
    status)
        run_engine "status.sh"
        ;;
    session|sessions)
        shift || true
        run_engine "sessions.sh" "$@"
        ;;
    story)
        shift || true
        run_engine "story.sh" "$@"
        ;;
    report)
        case "$SUBCOMMAND" in
            day)
                run_engine "report_day.sh"
                ;;
            week)
                run_engine "report_week.sh"
                ;;
            month)
                run_engine "report_month.sh"
                ;;
            *)
                show_help
                exit 1
                ;;
        esac
        ;;
    update)
        run_engine "update.sh"
        ;;
    help|"")
        show_help
        ;;
    *)
        show_help
        exit 1
        ;;
esac
